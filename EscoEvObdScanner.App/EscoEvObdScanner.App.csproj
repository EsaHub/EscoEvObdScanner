<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- the Windows 10 SDK version brings the Bluetooth LE API (Windows.Devices.Bluetooth) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EscoEvObdScanner.App</RootNamespace>
    <AssemblyName>EscoEvObdScanner.App</AssemblyName>
    <Product>Esco EV OBD Scanner</Product>
    <ApplicationIcon>Themes\app.ico</ApplicationIcon>
    <!-- ThemeMode (Fluent dark theme) is marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EscoEvObdScanner.AppLogic\EscoEvObdScanner.AppLogic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\EscoEvObdScanner\cars\*.json" Link="cars\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- which Bluetooth LE devices are listed as adapters and which of their services are used -->
    <Content Include="ble-adapters.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- the user guide, one page per language, opened from the ? button and the Start menu -->
    <Content Include="Help\*.html" Link="help\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Themes\app.ico" />
  </ItemGroup>

</Project>
