<Window x:Class="EscoEvObdScanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="clr-namespace:EscoEvObdScanner.App.Infrastructure"
        xmlns:v="clr-namespace:EscoEvObdScanner.App.Views"
        Title="Esco EV OBD Scanner" Width="1360" Height="900" MinWidth="1000" MinHeight="560"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        Icon="Themes/app.ico" WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource AppLogo}" Width="32" Height="32" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="Esco EV OBD Scanner" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </StackPanel>

                <!-- connection status pill -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="14"
                        Padding="14,5" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.Adapter.IsConnected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource GoodBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.Adapter.IsDemo}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource VioletBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.Adapter.IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State.Adapter.IsBusy}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- one button per language file -->
                    <ItemsControl ItemsSource="{Binding Languages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><Button Content="{Binding Code}" Command="{Binding Select}" Padding="10,4" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="?" ToolTip="{i:T HelpButton}" Command="{Binding OpenHelp}" Padding="12,4" Margin="8,0,0,0" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- error bar -->
        <Border DockPanel.Dock="Top" Background="#3A1618" BorderBrush="{StaticResource BadBrush}" BorderThickness="0,0,0,1"
                Padding="18,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DismissError}" Padding="8,2" Margin="0" />
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- footer; its height is fixed, so the live view's notice on the right moves nothing when it comes and goes -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0" Padding="18,0" Height="36">
            <DockPanel VerticalAlignment="Center">
                <!-- the live view holds the adapter: the reading tabs wait for it -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding ShowLiveNotice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{i:T LiveRunningNotice}" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="{i:T LiveStop}" Command="{Binding Live.Stop}" Padding="10,1" Margin="0" />
                </StackPanel>
                <TextBlock Text="{i:T ReadOnlyNote}" Style="{StaticResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="10,8,10,6" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="{i:T TabConnection}">
                <v:ConnectionView DataContext="{Binding Connection}" />
            </TabItem>
            <TabItem Header="{i:T TabDashboard}">
                <v:DashboardView DataContext="{Binding Live}" />
            </TabItem>
            <TabItem Header="{i:T TabBattery}">
                <v:BatteryView DataContext="{Binding Live}" />
            </TabItem>
            <TabItem Header="{i:T TabCharts}">
                <v:ChartsView DataContext="{Binding Live}" />
            </TabItem>
            <TabItem Header="{i:T TabDtc}">
                <v:DtcView DataContext="{Binding Dtc}" />
            </TabItem>
            <TabItem Header="{i:T TabEcus}">
                <v:BrowseView DataContext="{Binding Browse}" />
            </TabItem>
            <!-- research: first the ECUs, then the identifiers of one -->
            <TabItem Header="{i:T TabDiscovery}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="540" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <v:EcuView DataContext="{Binding Discovery}" />
                    <v:ScanView Grid.Column="1" DataContext="{Binding Scan}" />
                </Grid>
            </TabItem>
            <TabItem Header="{i:T TabCompare}">
                <v:CompareView DataContext="{Binding Compare}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
