        <DrawingImage.Drawing>
            <DrawingGroup>
                    <GeometryDrawing Brush="#0b1220">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,256,256" RadiusX="56" RadiusY="56" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#e2e8f0">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="58,58,34,22" RadiusX="5" RadiusY="5" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#e2e8f0">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="164,58,34,22" RadiusX="5" RadiusY="5" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#0f172a">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="28,78,200,128" RadiusX="16" RadiusY="16" /></GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen><Pen Brush="#e2e8f0" Thickness="10" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#94a3b8">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="64,95,22,7" RadiusX="2" RadiusY="2" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#94a3b8">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="170,95,22,7" RadiusX="2" RadiusY="2" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#94a3b8">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="177.5,87.5,7,22" RadiusX="2" RadiusY="2" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#22d3ee">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="40,122,20,70" RadiusX="4" RadiusY="4" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#22d3ee">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="68,122,20,70" RadiusX="4" RadiusY="4" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#22d3ee">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="96,122,20,70" RadiusX="4" RadiusY="4" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#f59e0b">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="124,136,20,56" RadiusX="4" RadiusY="4" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#22d3ee">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="152,122,20,70" RadiusX="4" RadiusY="4" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#22d3ee">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="180,122,20,70" RadiusX="4" RadiusY="4" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Palette: dark instrument panel, cyan accent, traffic-light status colours -->
    <Color x:Key="BgColor">#0B0F14</Color>
    <Color x:Key="PanelColor">#121821</Color>
    <Color x:Key="PanelBorderColor">#1E2733</Color>
    <Color x:Key="TextColor">#E6EDF3</Color>
    <Color x:Key="MutedColor">#8B98A5</Color>
    <Color x:Key="AccentColor">#22D3EE</Color>
    <Color x:Key="GoodColor">#34D399</Color>
    <Color x:Key="WarnColor">#FBBF24</Color>
    <Color x:Key="BadColor">#F87171</Color>
    <Color x:Key="VioletColor">#A78BFA</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />

    <FontFamily x:Key="NumberFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- A framed panel; a caption inside it uses the Caption style -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="6" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- a help list: a label in the left column and its text in the right -->
    <Style x:Key="HelpHead" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Margin" Value="0,2,12,0" />
    </Style>
    <Style x:Key="HelpText" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#0B0F14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,7" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Number tile -->
    <Style TargetType="c:Tile">
        <Setter Property="Margin" Value="6" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Accent" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Tile">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Value}" Foreground="{TemplateBinding Accent}"
                                           FontFamily="{StaticResource NumberFont}" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="{TemplateBinding Unit}" Foreground="{StaticResource MutedBrush}"
                                           FontSize="13" Margin="6,0,0,4" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock x:Name="NoteText" Text="{TemplateBinding Note}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Note" Value="">
                            <Setter TargetName="NoteText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="ClipboardCopyMode" Value="IncludeHeader" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="EnableRowVirtualization" Value="True" />
    </Style>

</ResourceDictionary>
