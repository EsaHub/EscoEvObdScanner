<UserControl x:Class="EscoEvObdScanner.App.Views.ChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:EscoEvObdScanner.App.Infrastructure"
             xmlns:c="clr-namespace:EscoEvObdScanner.App.Controls">
    <DockPanel Margin="4">
        <DockPanel DockPanel.Dock="Top" Margin="6,4,6,8">
            <Button Content="{i:T LiveStart}" Command="{Binding Start}" Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
            <Button Content="{i:T LiveStop}" Command="{Binding Stop}" />
            <Button Content="{i:T ClearCharts}" Command="{Binding ClearCharts}" />
            <TextBlock Text="{i:T ChartWindow}" VerticalAlignment="Center" Margin="16,0,8,0" />
            <ComboBox ItemsSource="{Binding WindowChoices}" SelectedItem="{Binding WindowMinutes}" Width="90" HorizontalAlignment="Left">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat={}{0} min}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <UniformGrid Columns="2" Rows="4">
            <c:LineChart Margin="6" Title="{i:T Power}" Unit="kW" ZeroLine="True" Series="{Binding PowerChart}"
                         Revision="{Binding Revision}" WindowSeconds="{Binding WindowSeconds}" />
            <c:LineChart Margin="6" Title="{i:T Speed}" Unit="km/h" Series="{Binding SpeedChart}"
                         Revision="{Binding Revision}" WindowSeconds="{Binding WindowSeconds}" />
            <c:LineChart Margin="6" Title="{i:T Current}" Unit="A" ZeroLine="True" Series="{Binding CurrentChart}"
                         Revision="{Binding Revision}" WindowSeconds="{Binding WindowSeconds}" />
            <c:LineChart Margin="6" Title="{i:T Soc}" Unit="%" Series="{Binding SocChart}"
                         Revision="{Binding Revision}" WindowSeconds="{Binding WindowSeconds}" />
            <c:LineChart Margin="6" Title="{i:T Voltage}" Unit="V" Series="{Binding VoltageChart}"
                         Revision="{Binding Revision}" WindowSeconds="{Binding WindowSeconds}" />
            <c:LineChart Margin="6" Title="{i:T CellSpread}" Unit="mV" Series="{Binding SpreadChart}"
                         Revision="{Binding Revision}" WindowSeconds="{Binding WindowSeconds}" />
            <c:LineChart Margin="6" Title="{i:T Temperatures}" Unit="°C" Series="{Binding TempChart}"
                         Revision="{Binding Revision}" WindowSeconds="{Binding WindowSeconds}" />
        </UniformGrid>
    </DockPanel>
</UserControl>
