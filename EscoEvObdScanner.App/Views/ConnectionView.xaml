<UserControl x:Class="EscoEvObdScanner.App.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:EscoEvObdScanner.App.Infrastructure">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{i:T Car}" Style="{StaticResource Caption}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{i:T VehicleAddButton}" Command="{Binding AddVehicle}" Margin="0,0,8,0" />
                        <Button Content="{i:T VehicleRemoveButton}" Command="{Binding RemoveVehicle}" />
                    </StackPanel>
                    <TextBlock Text="{i:T VehicleHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,10" />
                    <ComboBox ItemsSource="{Binding Cars}" SelectedItem="{Binding SelectedCar}" DisplayMemberPath="Title"
                              IsEnabled="{Binding CanChangeCar}" />
                    <TextBlock Text="{Binding CarCovers}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{i:T CarHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{i:T Adapter}" Style="{StaticResource Caption}" />

                    <TextBlock Text="{i:T Port}" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,10" IsEnabled="{Binding NeedsAdapter}">
                        <Button DockPanel.Dock="Right" Content="⟳" ToolTip="{i:T RefreshPorts}" Command="{Binding RefreshPorts}"
                                Margin="8,0,0,0" Padding="10,4" />
                        <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" />
                    </DockPanel>

                    <TextBlock Text="{i:T Baud}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding Baud}" Margin="0,0,0,4" IsEnabled="{Binding NeedsAdapter}" />
                    <TextBlock Text="{i:T BaudHint}" Style="{StaticResource Hint}" Margin="0,0,0,14" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{i:T Connect}" Command="{Binding Connect}" Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
                        <Button Content="{i:T Disconnect}" Command="{Binding Disconnect}" />
                    </StackPanel>
                    <TextBlock Text="{i:T DemoHint}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{i:T Safety}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{i:T SafetyText}" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" />
                    <TextBlock Text="{i:T ReadOnlyNote}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{i:T Catalog}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding State.CatalogPath}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                    <TextBlock Text="{i:T CatalogHint}" Style="{StaticResource Hint}" Margin="0,6,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{i:T Browse}" Command="{Binding BrowseCatalog}" />
                        <Button Content="{i:T ResetCatalog}" ToolTip="{i:T ResetCatalogHint}" Command="{Binding ResetCatalog}" />
                    </StackPanel>

                    <TextBlock Text="{i:T DataFolder}" Style="{StaticResource Caption}" Margin="0,16,0,8" />
                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Content="{i:T OpenFolder}" Command="{Binding OpenDataFolder}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Style="{StaticResource Panel}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="{i:T ClearLog}" Command="{Binding ClearLog}" Margin="0" />
                    <CheckBox DockPanel.Dock="Right" Content="{i:T ShowTraffic}" IsChecked="{Binding ShowTraffic}" Margin="0,0,12,0" />
                    <TextBlock Text="{i:T Log}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0" />
                </DockPanel>
                <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         Background="{StaticResource BgBrush}" BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
