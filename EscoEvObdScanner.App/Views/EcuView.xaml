<UserControl x:Class="EscoEvObdScanner.App.Views.EcuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:EscoEvObdScanner.App.Infrastructure">
    <DockPanel Margin="4">
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}">
            <StackPanel>
                <TextBlock Text="{i:T EcuFindHead}" Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding Ranges}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <WrapPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{i:T From}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" Width="70" FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{i:T To}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" Width="70" FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                    <Button Content="{Binding MainLabel}" Command="{Binding UseMain}" VerticalAlignment="Bottom" Margin="0,0,8,0"
                            Visibility="{Binding HasMain, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding WideLabel}" Command="{Binding UseWide}" VerticalAlignment="Bottom" />
                </WrapPanel>
                <TextBlock Text="{Binding RangeInfo}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0" />
                <TextBlock Text="{Binding SearchedInfo}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{i:T Discover}" Command="{Binding Discover}" Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
                    <Button Content="{i:T Stop}" Command="{Binding Stop}" />
                </StackPanel>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="6" Margin="0,12,0,6" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Mono}" />
                <TextBlock Text="{i:T EcuHowItWorks}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="{Binding SavedInfo}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
        <Button DockPanel.Dock="Bottom" Content="{i:T EcuAddNew}" Command="{Binding AddNew}" HorizontalAlignment="Left" Margin="10,4,10,8" />
        <Border Style="{StaticResource Panel}" Padding="0">
            <DataGrid ItemsSource="{Binding Found}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{i:T Name}" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="{i:T EcuStatus}" Binding="{Binding Status}" Width="80" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="{i:T Address}" Binding="{Binding Address}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
