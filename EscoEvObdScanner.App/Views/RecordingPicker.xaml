<Window x:Class="EscoEvObdScanner.App.Views.RecordingPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="clr-namespace:EscoEvObdScanner.App.Infrastructure"
        Title="{i:T RecordingPickTitle}" Width="700" Height="460" MinWidth="480" MinHeight="300"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="{i:T RecordingPickHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{i:T RecordingPickOpen}" IsDefault="True" Click="OnOpen" Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
            <Button Content="{i:T RecordingPickCancel}" IsCancel="True" />
        </StackPanel>
        <ListBox x:Name="List" DisplayMemberPath="Text" MouseDoubleClick="OnDoubleClick"
                 Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                 FontFamily="{StaticResource NumberFont}" Padding="4" />
    </DockPanel>
</Window>
