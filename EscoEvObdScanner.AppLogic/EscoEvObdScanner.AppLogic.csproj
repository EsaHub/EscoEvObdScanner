<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the app does apart from drawing it: view models, services, report, UI texts.
       No Windows UI types; the platform plugs in through Infrastructure/AppHost.cs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EscoEvObdScanner.AppLogic</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- PDFsharp brings 8.0.1, which has known denial-of-service flaws (GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7); the report never signs or decrypts, but the fixed version is used all the same -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- hooks for the self-test, which runs in the app -->
    <InternalsVisibleTo Include="EscoEvObdScanner.App" />
    <!-- and for the tests -->
    <InternalsVisibleTo Include="EscoEvObdScanner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EscoEvObdScanner.Core\EscoEvObdScanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI texts, one file per language; read by Infrastructure/Loc.cs -->
    <EmbeddedResource Include="Localization\*.json" LogicalName="Localization.%(Filename).json" />
  </ItemGroup>

</Project>
