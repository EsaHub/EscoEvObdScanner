<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EscoEvObdScanner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- the simulated car's data hooks are for the tests -->
    <InternalsVisibleTo Include="EscoEvObdScanner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/demo-car.jsonl" LogicalName="EscoEvObdScanner.Resources.demo-car.jsonl" />
  </ItemGroup>

</Project>
